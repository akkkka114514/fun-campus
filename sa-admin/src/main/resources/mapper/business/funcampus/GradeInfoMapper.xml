<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="net.lab1024.sa.admin.module.business.funcampus.gradeInfo.dao.GradeInfoDao">

    <!-- 查询结果列 -->
    <sql id="base_columns">
        grade_info.id,
        grade_info.name,
        grade_info.deleted_flag,
        grade_info.create_time,
        grade_info.udpate_time
    </sql>

    <!-- 分页查询 -->
    <select id="queryPage" resultType="net.lab1024.sa.admin.module.business.funcampus.gradeInfo.domain.vo.GradeInfoVO">
        SELECT
        <include refid="base_columns"/>
        FROM grade_info
    </select>

    <update id="batchUpdateDeleted">
        update grade_info set deleted_flag = #{deletedFlag}
        where id in
        <foreach collection="idList" open="(" close=")" separator="," item="item">
            #{item}
        </foreach>
    </update>

    <update id="updateDeleted">
        update grade_info set deleted_flag = #{deletedFlag}
        where id = #{id}
    </update>

    <select id="getAll" resultType="net.lab1024.sa.admin.module.business.funcampus.gradeInfo.domain.vo.SimpleGradeInfoVO">
        select id,name from grade_info
        where deleted_flag = 0
    </select>
</mapper>
