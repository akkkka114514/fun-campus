<?xml version="1.0" encoding="UTF-8"?>
<svg width="750px" height="280px" viewBox="0 0 750 280" version="1.1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
    <defs>
        <linearGradient x1="0%" y1="0%" x2="100%" y2="100%" id="linearGradient-1">
            <stop stop-color="#FF8C42" offset="0%"></stop>
            <stop stop-color="#FF6B35" offset="100%"></stop>
        </linearGradient>
        <radialGradient cx="50%" cy="50%" fx="50%" fy="50%" r="75%" id="radialGradient-2">
            <stop stop-color="#FF8C42" stop-opacity="0.8" offset="0%"></stop>
            <stop stop-color="#FF6B35" stop-opacity="0.4" offset="100%"></stop>
        </radialGradient>
    </defs>
    <g id="Page-1" stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
        <rect id="bg" fill="url(#linearGradient-1)" x="0" y="0" width="750" height="280"></rect>
        <circle fill="url(#radialGradient-2)" cx="600" cy="50" r="200"></circle>
        <circle fill="url(#radialGradient-2)" cx="200" cy="200" r="150"></circle>
        <circle fill="url(#radialGradient-2)" cx="400" cy="100" r="100"></circle>
    </g>
</svg>