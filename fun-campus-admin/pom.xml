<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.akkkka</groupId>
        <artifactId>fun-campus-parent</artifactId>
        <version>3.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>fun-campus-admin</artifactId>
    <version>3.0.0</version>
    <packaging>jar</packaging>

    <name>fun-campus-admin</name>

    <description>启动模块：应用入口/Web 配置/拦截器，打包输出可执行 jar</description>

    <dependencies>

        <dependency>
            <groupId>com.akkkka</groupId>
            <artifactId>fun-campus-system</artifactId>
            <version>3.0.0</version>
        </dependency>

        <dependency>
            <groupId>com.akkkka</groupId>
            <artifactId>fun-campus-funcampus</artifactId>
            <version>3.0.0</version>
        </dependency>

        <dependency>
            <groupId>com.akkkka</groupId>
            <artifactId>fun-campus-core</artifactId>
            <version>3.0.0</version>
        </dependency>

        <dependency>
            <groupId>com.akkkka</groupId>
            <artifactId>fun-campus-support-base</artifactId>
            <version>3.0.0</version>
        </dependency>

        <dependency>
            <groupId>com.akkkka</groupId>
            <artifactId>fun-campus-support-log</artifactId>
            <version>3.0.0</version>
        </dependency>

        <dependency>
            <groupId>com.akkkka</groupId>
            <artifactId>fun-campus-support-feature</artifactId>
            <version>3.0.0</version>
        </dependency>

        <dependency>
            <groupId>com.akkkka</groupId>
            <artifactId>fun-campus-support-ai</artifactId>
            <version>3.0.0</version>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.akkkka.admin.AdminApplication</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
